{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "conf": ["./config.js"],
      "@prisma": ["./src/components/global/prisma.ts"],
      "@comp-modals/*": ["./src/components/modals/*"],
      "@comp-ui/*": ["./src/components/ui/*"],
      "@comp-action/*": ["./src/components/action/*"],
      "@comp-global/*": ["./src/components/global/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "t1.jsx", "t.jsx"],
  "exclude": ["node_modules"]
}
